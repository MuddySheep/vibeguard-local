# Dependencies
node_modules/
.pnpm-store/

# Build output
dist/
*.tsbuildinfo

# Test + coverage
coverage/
.nyc_output/

# Editor + OS
.vscode/
.idea/
.DS_Store
Thumbs.db
*.swp

# Logs
*.log
npm-debug.log*
pnpm-debug.log*

# Environment
.env
.env.local

# Lockfiles we don't use (pnpm-lock.yaml IS tracked at the workspace root)
package-lock.json
yarn.lock
bun.lockb

# Build artifacts that should never be committed
*.tgz
.tsimp/

# Generated source files — regenerated from canonical sources at
# prebuild / pretest / pretypecheck time. Never edit by hand;
# never commit.
**/*.generated.ts

# Local smoke-install scratch (kept out of git; recreated each phase)
.smoke-*/

# Bench per-run results (baseline.json IS tracked; per-run results are noise)
benchmarks/results/
**/benchmarks/results/

# Local planning / workflow notes — kept on the maintainer's machine,
# not part of the public repo. (The shipped artifacts the planning
# describes — sources, tests, examples, ARCHITECTURE.md, etc. — are
# tracked normally.)
docs/EPIC-WORKFLOW.md
docs/epics/
docs/stories/
**/docs/EPIC-WORKFLOW.md
**/docs/epics/
**/docs/stories/

# Local prompt drops — never commit
attached_assets/

# Local adapter-manifest exploration material. Under review for a
# future story (probably v1.7.2 or v1.8.0) that builds on the
# existing v1.7.1 install-skill subcommand. Until that story lands,
# the content here is local-only; nothing ships from these paths.
packages/sdk/docs/.agent/
packages/sdk/docs/adapters/
