# Dependencies
node_modules/
.pnpm-store/

# Build output
dist/
*.tsbuildinfo

# Test + coverage
coverage/
.nyc_output/

# Editor + OS
.vscode/
.idea/
.DS_Store
Thumbs.db
*.swp

# Logs
*.log
npm-debug.log*
pnpm-debug.log*

# Environment
.env
.env.local

# Lockfiles we don't use (pnpm-lock.yaml IS tracked at the workspace root)
package-lock.json
yarn.lock
bun.lockb

# Build artifacts that should never be committed
*.tgz
.tsimp/

# Local smoke-install scratch (kept out of git; recreated each phase)
.smoke-*/

# Bench per-run results (baseline.json IS tracked; per-run results are noise)
benchmarks/results/
**/benchmarks/results/

# Local planning / workflow notes — kept on the maintainer's machine,
# not part of the public repo. (The shipped artifacts the planning
# describes — sources, tests, examples, ARCHITECTURE.md, etc. — are
# tracked normally.)
docs/EPIC-WORKFLOW.md
docs/epics/
docs/stories/
**/docs/EPIC-WORKFLOW.md
**/docs/epics/
**/docs/stories/
