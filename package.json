{
  "name": "vibeguard-local-monorepo",
  "version": "0.0.0",
  "private": true,
  "description": "Monorepo for the @vibeguard-dev/local SDK and its ancillary tooling (ESLint plugin, shared UI, web playground).",
  "type": "module",
  "scripts": {
    "build": "pnpm --filter @vibeguard-dev/local build",
    "test": "pnpm --filter @vibeguard-dev/local test",
    "test:coverage": "pnpm --filter @vibeguard-dev/local test:coverage",
    "typecheck": "pnpm --filter @vibeguard-dev/local typecheck",
    "lint": "pnpm --filter @vibeguard-dev/local lint",
    "lint:fix": "pnpm --filter @vibeguard-dev/local lint:fix",
    "size": "pnpm --filter @vibeguard-dev/local size",
    "bench": "pnpm --filter @vibeguard-dev/local bench",
    "bench:update-baseline": "pnpm --filter @vibeguard-dev/local bench:update-baseline"
  },
  "packageManager": "pnpm@10.28.1",
  "engines": {
    "node": ">=18.0.0"
  },
  "license": "Apache-2.0",
  "author": "MuddySheep (https://github.com/MuddySheep)",
  "homepage": "https://github.com/MuddySheep/vibeguard-local#readme",
  "bugs": {
    "url": "https://github.com/MuddySheep/vibeguard-local/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MuddySheep/vibeguard-local.git"
  }
}
